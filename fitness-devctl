#!/usr/bin/env python3
"""
fitness-devctl — Fitness Centre Stack Control
Controls: Node API (:9100, fitness-dev.service) + Python Backend (:9150, fitness-api.service)
Deploy: ~/dev/fitness-dev → /opt/fitness (fitness.service, system scope, sudo)

Terminal-facing dispatcher: ~/fitness/bin/fitness (domain CLI, catalog, sessions, coverage etc.)
This script handles ONLY: service control + deploy.
"""

import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional
import urllib.request

import psutil
import typer
from wasabi import Printer
from rich.console import Console
from rich.table import Table

msg = Printer()
console = Console()

app = typer.Typer(help="Fitness Centre Stack Control", no_args_is_help=True)

# ── Config ────────────────────────────────────────────────────────────────────

DEV_DIR = Path(__file__).resolve().parent
NODE_SERVICE = os.getenv("FITNESS_NODE_SERVICE", "fitness-dev.service")
PYTHON_SERVICE = os.getenv("FITNESS_PYTHON_SERVICE", "fitness-api.service")
NODE_PORT = os.getenv("FITNESS_NODE_PORT", "9100")
PYTHON_PORT = os.getenv("FITNESS_PYTHON_PORT", "9150")
NODE_URL = f"http://127.0.0.1:{NODE_PORT}"
PYTHON_URL = f"http://127.0.0.1:{PYTHON_PORT}"
LOGFILE_NODE = Path("/tmp/fitness-node.log")
LOGFILE_PYTHON = Path("/tmp/fitness-python.log")

# ── Helpers ───────────────────────────────────────────────────────────────────

def _http_ok(url: str, timeout: float = 2.0) -> tuple[bool, Optional[int]]:
    """Health-Check + Latenz in ms (None wenn nicht erreichbar)."""
    t0 = time.monotonic()
    try:
        urllib.request.urlopen(url, timeout=timeout)
        return True, int((time.monotonic() - t0) * 1000)
    except Exception:
        return False, None

def _service_active(unit: str) -> bool:
    r = subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit],
        capture_output=True,
    )
    return r.returncode == 0

def _service_enabled(unit: str) -> bool:
    r = subprocess.run(
        ["systemctl", "--user", "is-enabled", "--quiet", unit],
        capture_output=True,
    )
    return r.returncode == 0

def _ctl(unit: str, *args: str) -> int:
    r = subprocess.run(["systemctl", "--user", *args, unit])
    return r.returncode

def _main_pid(unit: str) -> Optional[int]:
    r = subprocess.run(
        ["systemctl", "--user", "show", unit, "-p", "MainPID"],
        capture_output=True, text=True,
    )
    try:
        pid = int(r.stdout.strip().split("=", 1)[1])
        return pid or None
    except Exception:
        return None

def _uptime(pid: Optional[int]) -> str:
    if not pid:
        return "-"
    try:
        secs = int(time.time() - psutil.Process(pid).create_time())
    except Exception:
        return "-"
    if secs < 60:
        return f"{secs}s"
    mins, s = divmod(secs, 60)
    if mins < 60:
        return f"{mins}m{s}s"
    hrs, m = divmod(mins, 60)
    return f"{hrs}h{m}m"

def _probe(label: str, unit: str, url: str) -> dict:
    active = _service_active(unit)
    enabled = _service_enabled(unit)
    pid = _main_pid(unit) if active else None
    health_ok, latency = _http_ok(url)
    return {
        "label": label, "unit": unit, "url": url,
        "active": active, "enabled": enabled,
        "pid": pid, "uptime": _uptime(pid),
        "health": health_ok, "latency": latency,
    }

def _render_stack_table(rows: list[dict]) -> None:
    table = Table(title="Fitness Dev Stack")
    table.add_column("Service", no_wrap=True)
    table.add_column("Active", no_wrap=True)
    table.add_column("Boot", no_wrap=True)
    table.add_column("PID", no_wrap=True, justify="right")
    table.add_column("Uptime", no_wrap=True, justify="right")
    table.add_column("Health", no_wrap=True)
    for r in rows:
        active_s = "[green]up[/green]" if r["active"] else "[red]down[/red]"
        boot_s = "[green]enabled[/green]" if r["enabled"] else "[yellow]disabled[/yellow]"
        if r["health"]:
            health_s = f"[green]ok[/green] {r['latency']}ms"
        else:
            health_s = "[red]unreachable[/red]"
        table.add_row(r["label"], active_s, boot_s, str(r["pid"] or "-"), r["uptime"], health_s)
    console.print(table)
    for r in rows:
        console.print(f"  {r['label']} ({r['unit']}): {r['url']}", style="dim")

def _stack_rows(node: bool, python: bool) -> list[dict]:
    rows = []
    if node:
        rows.append(_probe("Node API", NODE_SERVICE, NODE_URL))
    if python:
        rows.append(_probe("Python Backend", PYTHON_SERVICE, PYTHON_URL))
    return rows

# ── Commands ──────────────────────────────────────────────────────────────────

@app.command()
def status():
    """Show service + health status for all fitness-dev services."""
    _render_stack_table(_stack_rows(node=True, python=True))


@app.command()
def start(
    node: bool = typer.Option(True, help="Start Node API service"),
    python: bool = typer.Option(True, help="Start Python Backend service"),
):
    """Start fitness-dev services via systemd."""
    if node:
        rc = _ctl(NODE_SERVICE, "start")
        if rc != 0:
            msg.fail(f"systemctl start {NODE_SERVICE} exited {rc}")
    if python:
        rc = _ctl(PYTHON_SERVICE, "start")
        if rc != 0:
            msg.fail(f"systemctl start {PYTHON_SERVICE} exited {rc}")

    time.sleep(1)
    _wait_healthy(NODE_URL if node else None, PYTHON_URL if python else None)
    _render_stack_table(_stack_rows(node, python))


@app.command()
def stop(
    node: bool = typer.Option(True, help="Stop Node API service"),
    python: bool = typer.Option(True, help="Stop Python Backend service"),
):
    """Stop fitness-dev services."""
    if node:
        _ctl(NODE_SERVICE, "stop")
    if python:
        _ctl(PYTHON_SERVICE, "stop")
    _render_stack_table(_stack_rows(node, python))


@app.command()
def restart(
    node: bool = typer.Option(True, help="Restart Node API service"),
    python: bool = typer.Option(True, help="Restart Python Backend service"),
):
    """Restart fitness-dev services."""
    if node:
        _ctl(NODE_SERVICE, "restart")
    if python:
        _ctl(PYTHON_SERVICE, "restart")
    time.sleep(1)
    _wait_healthy(NODE_URL if node else None, PYTHON_URL if python else None)
    _render_stack_table(_stack_rows(node, python))


@app.command()
def enable(
    node: bool = typer.Option(True, help="Enable Node API autostart"),
    python: bool = typer.Option(True, help="Enable Python Backend autostart"),
):
    """Enable autostart on boot for fitness-dev services."""
    if node:
        _ctl(NODE_SERVICE, "enable")
        msg.good(f"{NODE_SERVICE} enabled (autostart)")
    if python:
        _ctl(PYTHON_SERVICE, "enable")
        msg.good(f"{PYTHON_SERVICE} enabled (autostart)")


@app.command()
def disable(
    node: bool = typer.Option(True, help="Disable Node API autostart"),
    python: bool = typer.Option(True, help="Disable Python Backend autostart"),
):
    """Disable autostart for fitness-dev services."""
    if node:
        _ctl(NODE_SERVICE, "disable")
        msg.good(f"{NODE_SERVICE} disabled")
    if python:
        _ctl(PYTHON_SERVICE, "disable")
        msg.good(f"{PYTHON_SERVICE} disabled")


@app.command()
def health():
    """Quick HTTP health check for both backends."""
    node_ok, node_ms = _http_ok(NODE_URL)
    python_ok, python_ms = _http_ok(PYTHON_URL)
    if node_ok:
        msg.good(f"Node API online ({NODE_URL}, {node_ms}ms)")
    else:
        msg.fail(f"Node API offline ({NODE_URL})")
    if python_ok:
        msg.good(f"Python Backend online ({PYTHON_URL}, {python_ms}ms)")
    else:
        msg.fail(f"Python Backend offline ({PYTHON_URL})")
    if not (node_ok and python_ok):
        raise typer.Exit(1)


@app.command()
def logs(
    service: str = typer.Argument("node", help="Which service: node | python | agent"),
    follow: bool = typer.Option(True, "-f/--no-follow", help="Follow log output"),
):
    """Follow systemd journal logs for a fitness service."""
    unit_map = {
        "node": NODE_SERVICE,
        "python": PYTHON_SERVICE,
        "agent": "fitness-api.service",
    }
    unit = unit_map.get(service)
    if not unit:
        msg.fail(f"Unknown service '{service}'. Use: node | python | agent")
        raise typer.Exit(1)

    cmd = ["journalctl", "--user", "-u", unit]
    if follow:
        cmd += ["-f", "--no-pager"]
    else:
        cmd += ["-n", "50", "--no-pager"]
    subprocess.run(cmd)


@app.command()
def dev():
    """Start Node API + Vite dev server in foreground (Ctrl+C to stop)."""
    msg.divider("Foreground Dev Mode (Ctrl+C to stop)")
    try:
        subprocess.run(["npm", "run", "dev"], cwd=DEV_DIR)
    except KeyboardInterrupt:
        print()
        msg.info("Stopped.")


@app.command()
def pydev():
    """Stop the systemd Python backend and run catalog.api --reload in foreground (Ctrl+C to restart the service)."""
    was_active = _service_active(PYTHON_SERVICE)
    if was_active:
        msg.info(f"Stopping {PYTHON_SERVICE} (port {PYTHON_PORT} freed for foreground reload)...")
        _ctl(PYTHON_SERVICE, "stop")

    msg.divider("Foreground Python Reload Mode (Ctrl+C to stop)")
    try:
        subprocess.run(
            [sys.executable, "-m", "fitness.catalog.api.api", "serve", "--port", PYTHON_PORT, "--reload"],
            cwd=DEV_DIR,
        )
    except KeyboardInterrupt:
        print()
        msg.info("Stopped.")
    finally:
        if was_active:
            msg.info(f"Restarting {PYTHON_SERVICE}...")
            _ctl(PYTHON_SERVICE, "start")
            msg.good(f"{PYTHON_SERVICE} back up")


CATALOG_UI_DIR = DEV_DIR / "catalog-ui"

@app.command()
def build(
    firebase: bool = typer.Option(False, "--firebase", help="Build Firebase/cloud variant"),
    catalog_ui: bool = typer.Option(
        True, help="catalog-ui (eigenes Vite-Projekt, gebaut nach fitness/catalog/dist/, "
                    "served vom Python-Backend unter /catalog-ui) mitbauen"
    ),
):
    """Run Vite production build. Baut standardmäßig auch catalog-ui mit — sonst bleibt
    /catalog-ui auf dem letzten manuellen Build-Stand stehen, ohne dass das auffällt."""
    script = "build:firebase" if firebase else "build"
    msg.info(f"Running: npm run {script}")
    subprocess.run(["npm", "run", script], cwd=DEV_DIR)

    if catalog_ui:
        if not CATALOG_UI_DIR.exists():
            msg.warn(f"catalog-ui/ nicht gefunden unter {CATALOG_UI_DIR} — übersprungen")
            return
        msg.info(f"Running: npm run build (catalog-ui, → fitness/catalog/dist/)")
        subprocess.run(["npm", "run", "build"], cwd=CATALOG_UI_DIR)


@app.command()
def deploy(
    dry_run: bool = typer.Option(False, "--dry-run", help="Show what would happen, no changes"),
    build: bool = typer.Option(False, "--build", help="Frischen Build erzwingen (deploy.sh --build-yes), sonst wird vorhandenes dist/ übernommen"),
):
    """Deploy ~/dev/fitness-dev → ~/fitness (staging) → /opt/fitness (prod), via deploy.sh.

    Delegiert an deploy.sh statt eigener Rsync-Logik zu duplizieren — deploy.sh
    kennt die vollständigen Excludes (u.a. fitness/catalog/kb, free-exercise-db,
    dist-versions) und behandelt rsync-Exitcode 23/24 (live schreibende Services
    während des Syncs) bereits korrekt als nicht-fatal. Die alte Eigenimplementierung
    hier hatte beides nicht → brach bei jedem kb/-Live-Write mit CalledProcessError ab
    (gefunden 2026-08-15).
    """
    deploy_script = DEV_DIR / "deploy.sh"
    if not deploy_script.exists():
        msg.fail(f"deploy.sh nicht gefunden unter {deploy_script}")
        raise typer.Exit(1)

    cmd_staging = ["bash", str(deploy_script), "staging"] + (["--build-yes"] if build else [])
    cmd_prod = ["bash", str(deploy_script), "prod"]

    if dry_run:
        msg.info(f"DRY RUN — würde ausführen:")
        msg.info(f"  {' '.join(cmd_staging)}")
        msg.info(f"  {' '.join(cmd_prod)}")
        return

    # Confirm before destructive sudo op (deploy.sh selbst fragt nicht nach)
    import shutil
    if not shutil.which("gum"):
        ans = input("Deploy ~/dev/fitness-dev → ~/fitness → /opt/fitness (sudo, restarts fitness.service)? [y/N] ")
        if ans.lower() != "y":
            msg.warn("Aborted.")
            raise typer.Exit(0)
    else:
        r = subprocess.run(["gum", "confirm", "Deploy ~/dev/fitness-dev → ~/fitness → /opt/fitness (sudo, restarts fitness.service)?"])
        if r.returncode != 0:
            msg.warn("Aborted.")
            raise typer.Exit(0)

    msg.info(f"Running: {' '.join(cmd_staging)}")
    subprocess.run(cmd_staging, cwd=DEV_DIR, check=True)

    msg.info(f"Running: {' '.join(cmd_prod)}")
    subprocess.run(cmd_prod, cwd=DEV_DIR, check=True)

    msg.good("Deploy complete (via deploy.sh: staging → prod)")


# ── Internal ──────────────────────────────────────────────────────────────────

def _wait_healthy(node_url: Optional[str], python_url: Optional[str], timeout: int = 10):
    for _ in range(timeout):
        node_ok = not node_url or _http_ok(node_url)[0]
        py_ok = not python_url or _http_ok(python_url)[0]
        if node_ok and py_ok:
            return
        time.sleep(1)
    msg.warn(f"Services not healthy after {timeout}s — check logs (fitness-devctl logs node|python)")


if __name__ == "__main__":
    app()
