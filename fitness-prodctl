#!/usr/bin/env python3
"""
fitness-prodctl — Fitness Prod Controller (system-scope services)

Kontrolliert die tatsächlich laufenden Prod-Services, getrennt von
fitness-devctl (Dev-Stack, --user-scope, fitness-dev.service etc.):
  - fitness.service     :6100  system-scope, Python/FastAPI (uvicorn) aus /opt/fitness (sudo für restart/stop)
  - fitness-api.service :9150  user-scope, WorkingDirectory ~/dev/fitness-dev (FastAPI/uvicorn)

Deploy: ./deploy.sh (baut in ~/dev/fitness-dev, rsynct nach /opt/fitness, restartet fitness.service)
Install: fitness-prodctl install (schreibt/aktualisiert die systemd-Unit selbst, sudo)
"""

# subprocess: Python-Standardbibliothek zum Starten anderer Programme (hier:
# journalctl, systemctl, sudo, bash) und Einsammeln von deren Exit-Code/Output.
import subprocess
# Path: objektorientierter Ersatz für rohe String-Pfade (z.B. "/opt/fitness/x").
# __file__ ist der Pfad dieses Skripts selbst — daraus leiten wir den Ordner ab,
# in dem deploy.sh liegen muss.
from pathlib import Path

# typer: baut aus normalen Python-Funktionen automatisch ein CLI mit
# --help, Argumenten, Optionen und Tab-Completion. Jede @app.command()-
# Funktion weiter unten wird dadurch zu einem Unterbefehl wie
# "fitness-prodctl status".
import typer
# wasabi.Printer: kleine Helper-Klasse für farbige Terminal-Ausgaben
# (msg.good = grün "✔", msg.fail = rot "✘", msg.info = blau "ℹ").
from wasabi import Printer

msg = Printer()

# no_args_is_help=True: wird das Skript ganz ohne Unterbefehl aufgerufen
# (nur "fitness-prodctl"), zeigt es die Hilfe statt nichts zu tun.
app = typer.Typer(help="Fitness Prod Controller", no_args_is_help=True)

# .resolve() macht aus einem relativen Pfad einen absoluten, .parent nimmt
# den Ordner statt der Datei selbst → Verzeichnis, in dem dieses Skript liegt.
DEV_DIR = Path(__file__).resolve().parent

# Namen der systemd-Units, die wir steuern. Als Konstanten oben definiert,
# damit man sie an einer einzigen Stelle ändern kann, statt sie im Code
# verstreut als Strings zu wiederholen.
PROD_SERVICE = "fitness.service"          # system-scope, sudo — seit der :6100-Migration Python/uvicorn, nicht mehr Node
SERVICES = {
    "api": (PROD_SERVICE, True),          # (unit, is_system_scope)
    "node": (PROD_SERVICE, True),         # Alias, historisch (war mal Node) — bleibt fuer Muskelgedaechtnis gueltig
}


def _journalctl_base(unit: str, system_scope: bool) -> list[str]:
    """Baut die Basis-Kommandozeile für journalctl (die Log-Anzeige von systemd).

    Wir bauen hier bewusst eine *Liste* von Strings ("journalctl", "-u", ...)
    statt eines einzigen Kommando-Strings — subprocess.run() erwartet das so
    und vermeidet damit Shell-Escaping-Probleme (z.B. wenn ein Unit-Name mal
    Leerzeichen oder Sonderzeichen enthalten würde).
    """
    cmd = ["journalctl", "-u", unit]
    if not system_scope:
        # --user-Units brauchen das --user-Flag, sonst sucht journalctl in
        # den System-weiten Logs statt in denen des eigenen Nutzers.
        cmd.insert(1, "--user")
    return cmd


def _systemctl(action: str, unit: str, system_scope: bool) -> int:
    """Führt systemctl <action> <unit> aus (z.B. "restart fitness.service").

    Gibt den Exit-Code des Unterprozesses zurück (0 = Erfolg, alles andere
    = Fehler) — Aufrufer können damit entscheiden, ob sie eine Fehlermeldung
    zeigen sollen.
    """
    # Für system-scope-Units stellen wir "sudo" voran, weil normale Nutzer
    # /etc/systemd/system/-Units nicht starten/stoppen dürfen.
    cmd = (["sudo"] if system_scope else []) + ["systemctl"]
    if not system_scope:
        cmd.append("--user")
    cmd += [action, unit]
    # subprocess.run() startet den Befehl, wartet auf sein Ende und gibt ein
    # CompletedProcess-Objekt zurück; .returncode ist dessen Exit-Status.
    return subprocess.run(cmd).returncode


# Der @app.command()-Dekorator registriert die Funktion darunter als
# Unterbefehl bei typer. Der Funktionsname wird automatisch zum Befehlsnamen
# ("status" → "fitness-prodctl status"), der Docstring wird zum --help-Text.
@app.command()
def status():
    """Status beider Prod-Services (gum-Tabelle falls verfügbar, sonst Klartext)."""
    # SERVICES.items() liefert (key, value)-Paare aus dem Dict oben, hier
    # also z.B. ("node", ("fitness.service", True)). Das Auspacken direkt
    # in der for-Zeile ("for name, (unit, system_scope) in ...") nennt man
    # Tuple-Unpacking — spart eine Zeile gegenüber "pair = ...; name = pair[0]".
    for name, (unit, system_scope) in SERVICES.items():
        cmd = ["systemctl"]
        if not system_scope:
            cmd.append("--user")
        cmd += ["is-active", unit]
        # capture_output=True fängt stdout/stderr des Unterprozesses ein,
        # statt sie direkt ins Terminal durchzureichen — wir wollen den Text
        # ja selbst auswerten. text=True gibt uns dabei normale Python-
        # Strings zurück statt roher bytes.
        result = subprocess.run(cmd, capture_output=True, text=True)
        # .strip() entfernt das Zeilenumbruch-Zeichen, das systemctl anhängt.
        # "or 'unknown'" ist ein kurzer Fallback: ist stdout leer (z.B. weil
        # der Befehl fehlschlug), zeigen wir "unknown" statt eines leeren Strings.
        state = result.stdout.strip() or "unknown"
        if state == "active":
            msg.good(f"{name} ({unit}): {state}")
        else:
            msg.fail(f"{name} ({unit}): {state}")


@app.command()
def logs(
    service: str = typer.Argument("api", help="Which service: api | node"),
    follow: bool = typer.Option(True, "-f/--no-follow", help="Follow log output"),
    lines: int = typer.Option(50, "-n", help="Number of lines when not following"),
):
    """Live-Logs des Prod-Services (journalctl -f)."""
    entry = SERVICES.get(service)
    if not entry:
        msg.fail(f"Unknown service '{service}'. Use: api | node")
        raise typer.Exit(1)
    unit, system_scope = entry

    cmd = _journalctl_base(unit, system_scope)
    if follow:
        # -f = "follow", journalctl bleibt offen und zeigt neue Zeilen live
        # (wie "tail -f"). --no-pager verhindert, dass die Ausgabe in einen
        # Pager wie "less" umgeleitet wird.
        cmd += ["-f", "--no-pager"]
    else:
        cmd += ["-n", str(lines), "--no-pager"]
    # Kein capture_output hier: wir WOLLEN, dass journalctl direkt ins
    # Terminal des Users schreibt (live mitlesen), nicht dass wir den Text
    # erst einsammeln und selbst wieder ausgeben.
    subprocess.run(cmd)


@app.command()
def restart(
    service: str = typer.Argument("api", help="Which service: api | node"),
):
    """Restartet einen Prod-Service (API braucht sudo)."""
    entry = SERVICES.get(service)
    if not entry:
        msg.fail(f"Unknown service '{service}'. Use: api | node")
        raise typer.Exit(1)
    unit, system_scope = entry

    msg.info(f"Restarting {unit}" + (" (sudo)" if system_scope else ""))
    rc = _systemctl("restart", unit, system_scope)
    if rc == 0:
        msg.good(f"{unit} restarted")
    else:
        msg.fail(f"{unit} restart failed (exit {rc})")
        raise typer.Exit(rc)


def _run_deploy_sh(target: str) -> int:
    deploy_script = DEV_DIR / "deploy.sh"
    if not deploy_script.exists():
        msg.fail(f"deploy.sh not found in {DEV_DIR}")
        raise typer.Exit(1)
    return subprocess.run(["bash", str(deploy_script), target], cwd=DEV_DIR).returncode


@app.command()
def deploy(target: str = typer.Argument("prod", help="staging | prod")):
    """Führt ./deploy.sh <target> aus (Build in SOURCE, rsync + restart, prod braucht sudo).

    Default ist bewusst 'prod', nicht 'staging' — dieses Skript ist der
    Prod-Controller (fitness-prodctl), 'fitness prod deploy' ohne weiteres
    Argument soll deshalb tatsächlich prod deployen, nicht (wie bis
    2026-08-22) versehentlich nochmal nur staging treffen. Für Staging
    weiterhin fitness-devctl deploy bzw. 'fitness-prodctl deploy staging'.
    """
    if target == "prod":
        import shutil
        prompt = "Deploy /opt/fitness (prod, sudo, restarts fitness.service)?"
        if shutil.which("gum"):
            r = subprocess.run(["gum", "confirm", prompt])
            confirmed = r.returncode == 0
        else:
            confirmed = input(f"{prompt} [y/N] ").lower() == "y"
        if not confirmed:
            msg.warn("Aborted.")
            raise typer.Exit(0)
    rc = _run_deploy_sh(target)
    if rc != 0:
        raise typer.Exit(rc)


# Unit-Inhalt + Install-Logik stecken seit 2026-08-21 direkt in deploy.sh
# (Schritt 3b, dort auch fuer staging/fitness-preview.service gueltig) -
# deploy.sh prod schreibt/aktualisiert /etc/systemd/system/fitness.service
# per Diff-Check selbst, bevor es restartet. install() bleibt nur noch als
# bekannter Einstiegspunkt/Alias erhalten.
@app.command()
def install():
    """Alias fuer 'deploy prod' - deploy.sh prod installiert/aktualisiert die
    fitness.service-Unit (sudo, mit Diff-Check) und deployt danach direkt
    weiter (rsync + venv + kb-Symlink + Restart)."""
    msg.info("Fuehre ./deploy.sh prod aus (Unit-Install + rsync + venv + kb-Symlink + Restart, sudo)")
    rc = _run_deploy_sh("prod")
    if rc == 0:
        msg.good("Deploy + Restart abgeschlossen — fitness.service laeuft jetzt Python/uvicorn aus /opt/fitness auf :6100.")
    else:
        msg.fail(f"deploy.sh prod fehlgeschlagen (exit {rc})")
        raise typer.Exit(rc)


# Dieser if-Block läuft nur, wenn das Skript direkt ausgeführt wird
# (python3 fitness-prodctl ...) — nicht, wenn es (wie in fitnessctl) als
# Modul importiert wird. app() startet dann typer, das die Kommandozeilen-
# Argumente parst und die passende @app.command()-Funktion aufruft.
if __name__ == "__main__":
    app()
