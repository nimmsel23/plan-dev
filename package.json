{
  "name": "plan",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "predev": "pnpm run build:kb-data",
    "dev": "node scripts/dev-runner.mjs",
    "start": "node ../plan-backend/server.mjs",
    "fitness:routines": "node scripts/fitness-routines.mjs",
    "ui:dev": "vite",
    "test:plan": "node scripts/tests/plan-document.test.mjs && node scripts/tests/programs.test.mjs && node scripts/tests/plan-client.test.mjs && node scripts/tests/plan-week.test.mjs && node scripts/tests/plan-updates.test.mjs && node scripts/tests/plan-versions.test.mjs && node scripts/tests/plan-microcycles.test.mjs && node scripts/tests/plan-active-macrocycle.test.mjs && node scripts/tests/plan-session-draft.test.mjs && node scripts/tests/plan-microcycle-progress.test.mjs && node scripts/tests/db-barrel-contract.test.mjs && node scripts/tests/plan.test.mjs && node scripts/tests/plan-firestore.test.mjs && python3 scripts/tests/test_plan_backend.py && python3 scripts/tests/test_plan_tasks.py",
    "test:rules": "bash scripts/tests/run-rules.sh",
    "test:plan:browser": "bash scripts/tests/run-plan-browser.sh",
    "test:session:browser": "bash scripts/tests/run-session-browser.sh",
    "lint": "eslint src/ Skills/ --ext .js,.jsx",
    "prebuild": "pnpm run build:kb-data",
    "build": "pnpm run lint && vite build && node scripts/snapshot.mjs dist",
    "build:preview": "pnpm run deploy:preview",
    "prebuild:firebase": "pnpm run build:kb-data",
    "build:kb-data": "pnpm run build:exercise-data && pnpm run build:coaching-notes",
    "build:exercise-data": "node scripts/exercise-data.mjs",
    "build:bulk-data": "node scripts/build-exercise-bulk-data.mjs",
    "build:ppl-data": "node scripts/build-ppl-data.mjs",
    "build:coaching-notes": "node scripts/build-coaching-notes.mjs",
    "build:firebase": "pnpm run build:firebase:plan",
    "build:firebase:client": "vite build --mode firebase --outDir dist-firebase && node scripts/stamp-sw.mjs dist-firebase && node scripts/snapshot.mjs dist-firebase",
    "build:firebase:plan": "vite build --mode plan --outDir dist-plan && node scripts/prepare-plan-dist.mjs && node scripts/mini-app-shell/cli.mjs stamp dist-plan --app plan",
    "deploy:firebase:plan": "firebase deploy --only hosting:plan",
    "stamp:sw": "node scripts/stamp-sw.mjs dist-firebase",
    "preview:firebase": "firebase hosting:channel:deploy preview --expires 1h",
    "deploy:firebase": "firebase deploy --only hosting:plan",
    "firebase": "pnpm run build:firebase && pnpm run deploy:firebase",
    "deploy": "node scripts/deploy-runner.mjs",
    "deploy:fitness": "bash ./deploy-app.sh",
    "deploy:vos": "bash ./deploy-app.sh vos",
    "deploy:local": "./deploy.sh staging",
    "deploy:prod": "./deploy.sh prod",
    "preview": "vite preview",
    "build:catalog": "python3 scripts/build-catalog.py",
    "deploy:preview": "pnpm run build:firebase && node scripts/deploy-preview.mjs",
    "deploy:prev": "pnpm run deploy:preview",
    "build:prev": "pnpm run deploy:preview",
    "tooling:biome": "pnpm dlx @biomejs/biome@2.6.6 check --formatter-enabled=true --linter-enabled=false --no-errors-on-unmatched scripts",
    "tooling:knip": "pnpm dlx knip@6.44.2 --no-progress",
    "tooling:check": "pnpm run tooling:biome && pnpm run tooling:knip",
    "test": "node --test scripts/smoke.test.mjs",
    "tooling:biome:lint": "pnpm dlx @biomejs/biome@2.6.6 check --formatter-enabled=true --linter-enabled=true --no-errors-on-unmatched scripts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.0",
    "@we-gold/gpxjs": "^1.2.0",
    "body-muscles": "^1.0.0",
    "buffer": "^6.0.3",
    "date-fns": "^4.4.0",
    "firebase": "^11.10.0",
    "fit-file-parser": "^5.2.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.7",
    "react-muscle-highlighter": "^1.2.0",
    "recharts": "^3.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  },
  "engines": {
    "node": ">=22.13"
  }
}
