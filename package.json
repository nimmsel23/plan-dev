{
  "name": "fitness-dev",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "cloud_chamber/journal-dev",
    "cloud_chamber/learn-dev",
    "cloud_chamber/vitalos"
  ],
  "scripts": {
    "predev": "npm run build:kb-data",
    "dev": "node scripts/dev-runner.mjs",
    "start": "node server.mjs",
    "fitness:routines": "node scripts/fitness-routines.mjs",
    "ui:dev": "vite",
    "lint": "eslint src/ 6pack/ Skills/ --ext .js,.jsx",
    "prebuild": "npm run build:kb-data",
    "build": "npm run lint && vite build && node scripts/snapshot.mjs dist",
    "build:preview": "npm run deploy:preview",
    "prebuild:firebase": "npm run build:kb-data",
    "build:kb-data": "npm run build:sixpack-data && npm run build:exercise-data && npm run build:coaching-notes",
    "build:sixpack-data": "node 6pack/build-data.mjs",
    "build:exercise-data": "node scripts/exercise-data.mjs",
    "build:bulk-data": "node scripts/build-exercise-bulk-data.mjs",
    "build:ppl-data": "node scripts/build-ppl-data.mjs",
    "build:coaching-notes": "node scripts/build-coaching-notes.mjs",
    "build:firebase": "npm run build:firebase:client",
    "build:firebase:client": "vite build --mode firebase --outDir dist-firebase && node scripts/stamp-sw.mjs dist-firebase && node scripts/snapshot.mjs dist-firebase",
    "build:firebase:plan": "vite build --mode plan --outDir dist-plan && node scripts/prepare-plan-dist.mjs",
    "deploy:firebase:plan": "firebase deploy --only hosting:plan",
    "stamp:sw": "node scripts/stamp-sw.mjs dist-firebase",
    "preview:firebase": "firebase hosting:channel:deploy preview --expires 1h",
    "deploy:firebase": "firebase deploy --only hosting:client",
    "firebase": "npm run build:firebase && npm run deploy:firebase",
    "deploy": "node scripts/deploy-runner.mjs",
    "deploy:local": "./deploy.sh staging",
    "deploy:prod": "./deploy.sh prod",
    "preview": "vite preview",
    "build:catalog": "python3 scripts/build-catalog.py",
    "deploy:preview": "npm run build:firebase && node scripts/deploy-preview.mjs",
    "deploy:prev": "npm run deploy:preview",
    "build:prev": "npm run deploy:preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.0.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@tanstack/react-query": "^5.101.0",
    "@we-gold/gpxjs": "^1.2.0",
    "better-sqlite3": "^12.10.0",
    "body-muscles": "^1.0.0",
    "buffer": "^6.0.3",
    "date-fns": "^4.4.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "fit-file-parser": "^5.2.1",
    "hono": "^4.12.19",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.453.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.7",
    "react-muscle-highlighter": "^1.2.0",
    "recharts": "^3.8.1",
    "zod": "^4.5.1",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@vos/cross-app-aliases": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.0"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  }
}
