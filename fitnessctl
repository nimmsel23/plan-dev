#!/usr/bin/env python3
"""
fitnessctl — Fitness Centre Server Controller (typer, autocompletion-ready)

Top-Level-Dispatcher, steuert Dev- und Prod-Stack getrennt an:
  fitnessctl dev   <cmd>   → fitness-devctl   (Dev-Stack, --user-scope: fitness-dev.service,
                              fitness-api.service)
  fitnessctl prod  <cmd>   → fitness-prodctl  (Prod-Stack, system-scope fitness.service :6100,
                              user-scope fitness-api.service :9150)

Domain commands (catalog, sessions, coverage etc.) → use: fitness
"""

import subprocess
import time
from pathlib import Path
# Optional[X] heißt "entweder ein X, oder None" — nutzen wir als Rückgabetyp
# von _load_module(), weil das Laden fehlschlagen kann (Datei fehlt, Syntax-
# fehler etc.) und wir dann bewusst None statt eines Moduls zurückgeben.
from typing import Optional

import typer
from wasabi import Printer

msg = Printer()

# __file__ ist der Pfad dieser Datei selbst; .resolve() macht daraus einen
# absoluten Pfad, .parent nimmt den Ordner statt der Datei — also den Ordner,
# in dem fitnessctl, fitness-devctl und fitness-prodctl nebeneinander liegen.
DEV_DIR = Path(__file__).resolve().parent

# no_args_is_help=True: "fitnessctl" ganz ohne Argument zeigt die Hilfe,
# statt stillschweigend nichts zu tun.
app = typer.Typer(help="Fitness Centre Server Controller", no_args_is_help=True)


def _load_module(name: str, filename: str):
    """Lädt ein anderes Python-Skript aus diesem Ordner als Modul nach — obwohl
    es keine .py-Endung hat und deshalb nicht per normalem "import" gefunden würde.

    Hintergrund: fitness-devctl und fitness-prodctl sind bewusst ausführbare
    CLI-Skripte ohne .py-Endung (man ruft sie direkt als "./fitness-devctl
    status" auf). Python kann trotzdem ihren Code laden — SourceFileLoader
    liest die Datei wie gewöhnlichen Python-Quellcode ein und macht daraus
    ein Modul-Objekt, dessen Inhalte (hier vor allem: die Variable "app",
    der typer-Unterbefehlsbaum) wir danach ganz normal ansprechen können.
    """
    path = DEV_DIR / filename
    if not path.exists():
        # Kein Absturz, wenn eine der beiden Dateien mal fehlt (z.B. während
        # eines Umbaus) — fitnessctl bleibt dann nutzbar, nur ohne diesen
        # Teilbereich. Siehe die if-Checks weiter unten.
        return None
    try:
        # Lokaler Import: SourceFileLoader wird nur hier gebraucht, deshalb
        # erst innerhalb der Funktion importiert statt ganz oben im File.
        from importlib.machinery import SourceFileLoader
        return SourceFileLoader(name, str(path)).load_module()
    except Exception as e:
        # Ein möglichst breites "except Exception" ist hier bewusst gewählt:
        # egal was beim Laden schiefgeht (Syntaxfehler, fehlender Import in
        # der Zieldatei etc.), fitnessctl soll trotzdem starten können und
        # nur eine Warnung zeigen statt komplett abzustürzen.
        msg.warn(f"Could not load {filename}: {e}")
        return None


# Beide Sub-Skripte laden. _devctl/_prodctl sind danach entweder die
# geladenen Module oder None (falls das Laden fehlschlug).
_devctl = _load_module("fitness_devctl", "fitness-devctl")
_prodctl = _load_module("fitness_prodctl", "fitness-prodctl")

# app.add_typer(...) hängt den kompletten Unterbefehlsbaum eines anderen
# typer.Typer()-Objekts unter einem neuen Namen in dieses App-Objekt ein.
# Aus "fitness-devctl status" (direkt aufgerufen) wird dadurch
# "fitnessctl dev status" (über den Dispatcher aufgerufen) — der Code in
# fitness-devctl bleibt dabei komplett unverändert, es wird nur zusätzlich
# unter einem Präfix erreichbar gemacht.
if _devctl and hasattr(_devctl, "app"):
    app.add_typer(_devctl.app, name="dev", help="Dev-Stack (Node :9100, Python :9150, --user-scope)")

if _prodctl and hasattr(_prodctl, "app"):
    app.add_typer(_prodctl.app, name="prod", help="Prod-Stack (Node :6100 system-scope, Python :9150 user-scope)")


# ── Firestore-Daemon ─────────────────────────────────────────────────────────
# `fitness-firestore-daemon.service` (user-scope) spiegelt Firestore-User-Data
# (sessions/journal/habits/habitRecords/habitJournals + Fuel nutrition/
# supplements) per on_snapshot nach ~/.aos/users/<uid>/fitness/. Läuft aus
# WorkingDirectory ~/dev/fitness-dev, `python3 -m fitness.firestore.mirror` —
# nach Code-Änderungen an mirror.py / journal_store.py muss er neugestartet
# werden, damit sie greifen.

DAEMON_UNIT = "fitness-firestore-daemon.service"

daemon_app = typer.Typer(
    help=f"Firestore-Mirror-Daemon ({DAEMON_UNIT}, user-scope) steuern",
    no_args_is_help=True,
)


def _sc(*args: str, capture: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", "--user", *args], capture_output=capture, text=True)


def _sc_prop(unit: str, prop: str) -> str:
    r = _sc("show", unit, "-p", prop, capture=True)
    out = (r.stdout or "").strip()
    return out.split("=", 1)[1] if "=" in out else ""


@daemon_app.command("status")
def daemon_status():
    """Aktiv-/Boot-Status, PID, Uptime und letzte Journal-Zeile."""
    active = _sc("is-active", "--quiet", DAEMON_UNIT).returncode == 0
    enabled = _sc("is-enabled", "--quiet", DAEMON_UNIT).returncode == 0
    pid = _sc_prop(DAEMON_UNIT, "MainPID")
    since = _sc_prop(DAEMON_UNIT, "ActiveEnterTimestamp")
    exec_start = _sc_prop(DAEMON_UNIT, "ExecStart")
    if "argv[]=" in exec_start:  # rohes systemd-Struct auf die Kommandozeile eindampfen
        exec_start = exec_start.split("argv[]=", 1)[1].split(" ; ", 1)[0]
    wd = _sc_prop(DAEMON_UNIT, "WorkingDirectory")

    msg.good(f"{DAEMON_UNIT}: active") if active else msg.fail(f"{DAEMON_UNIT}: inactive")
    print(f"  boot:      {'enabled' if enabled else 'disabled'}")
    print(f"  main pid:  {pid or '-'}")
    print(f"  since:     {since or '-'}")
    print(f"  workdir:   {wd or '-'}")
    print(f"  exec:      {exec_start or '-'}")
    log = subprocess.run(
        ["journalctl", "--user", "-u", DAEMON_UNIT, "-n", "5", "--no-pager", "-o", "short-iso"],
        capture_output=True, text=True,
    )
    if log.stdout.strip():
        print("  recent log:")
        for line in log.stdout.strip().splitlines():
            print(f"    {line}")


@daemon_app.command("restart")
def daemon_restart():
    """Daemon neustarten — nötig damit Code-Änderungen an mirror.py greifen."""
    rc = _sc("restart", DAEMON_UNIT).returncode
    if rc != 0:
        msg.fail(f"systemctl restart {DAEMON_UNIT} exited {rc}")
        raise typer.Exit(rc)
    time.sleep(2)
    daemon_status()


@daemon_app.command("start")
def daemon_start():
    """Daemon starten."""
    rc = _sc("start", DAEMON_UNIT).returncode
    if rc != 0:
        msg.fail(f"systemctl start {DAEMON_UNIT} exited {rc}")
        raise typer.Exit(rc)
    time.sleep(2)
    daemon_status()


@daemon_app.command("stop")
def daemon_stop():
    """Daemon stoppen (Firestore-User-Data-Sync pausiert bis Start)."""
    rc = _sc("stop", DAEMON_UNIT).returncode
    if rc != 0:
        msg.fail(f"systemctl stop {DAEMON_UNIT} exited {rc}")
        raise typer.Exit(rc)
    msg.good(f"{DAEMON_UNIT} gestoppt")


@daemon_app.command("enable")
def daemon_enable():
    """Autostart beim Login aktivieren."""
    _sc("enable", DAEMON_UNIT)
    msg.good(f"{DAEMON_UNIT} enabled (autostart)")


@daemon_app.command("disable")
def daemon_disable():
    """Autostart deaktivieren."""
    _sc("disable", DAEMON_UNIT)
    msg.good(f"{DAEMON_UNIT} disabled")


@daemon_app.command("logs")
def daemon_logs(
    follow: bool = typer.Option(True, "-f/--no-follow", help="Log-Ausgabe folgen"),
    lines: int = typer.Option(50, "-n", "--lines", help="Zeilen im No-Follow-Modus"),
):
    """systemd-Journal des Daemons anzeigen."""
    cmd = ["journalctl", "--user", "-u", DAEMON_UNIT, "-o", "short-iso"]
    cmd += ["-f", "--no-pager"] if follow else ["-n", str(lines), "--no-pager"]
    subprocess.run(cmd)


app.add_typer(daemon_app, name="daemon", help=f"Firestore-Mirror-Daemon ({DAEMON_UNIT})")


# Nur beim direkten Aufruf ausführen (python3 fitnessctl ...), nicht wenn
# diese Datei selbst irgendwo als Modul importiert würde.
if __name__ == "__main__":
    app()
