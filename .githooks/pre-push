#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Build-Verifikation auf `dev`. Standalone-Live = CI auf master; Shell-Pin = vos-release.
SKIP='(^|/)(AGENTS\.md|README([^/]*)?\.md)$|(^|/)docs/|\.(md|mdx|markdown|txt|bak|bak2)$|^dist(-plan|-firebase)?/'
DEPLOY_TRIGGER='^(src/|plan\.html$|public/|6pack/|Skills/|fitness/catalog/kb/|scripts/|vite\.config\.(js|ts|mjs)$|tailwind\.config\.cjs$|postcss\.config\.cjs$|package\.json$|pnpm-lock\.yaml$|firebase\.json$|firebase\.config\.js$|\.github/workflows/deploy-plan\.yml$)'

should_build_dev=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_ref:-}" ]] || continue
  branch="${local_ref#refs/heads/}"

  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    changed="$(git diff-tree --no-commit-id --name-only -r "$local_sha")"
  else
    changed="$(git diff --name-only "$remote_sha" "$local_sha")"
  fi

  relevant="$(printf '%s\n' "$changed" | grep -Ev "$SKIP" || true)"

  if [[ "$branch" == "dev" ]] && printf '%s\n' "$relevant" | grep -Eq "$DEPLOY_TRIGGER"; then
    should_build_dev=true
    echo "💡 Release: dev → master (Auto-Promote / vos-release-pr plan); Shell-Pin mit plan-release / vos-ship. Doku: ~/vitalos/docs/DEPLOYMENT.md" >&2
  fi
done

if [[ "$should_build_dev" == true ]]; then
  echo "🔍 plan-dev: prüfe @db-Exporte gegen alle Ziel-Barrels (fitness-dev u. a.)…"
  if ! node scripts/tests/db-barrel-contract.test.mjs >/dev/null; then
    node scripts/tests/db-barrel-contract.test.mjs 2>&1 | grep -A8 "Fehlende" >&2 || true
    echo "❌ @db-Vertrag verletzt — Push wird abgebrochen (Override: git push --no-verify)." >&2
    exit 1
  fi
  echo "🔍 plan-dev: Push zu dev — baue Plan-Firebase-Artefakt als Build-Verifikation…"
  if ! pnpm run build:firebase; then
    echo "❌ Plan-Build fehlgeschlagen — Push wird abgebrochen." >&2
    echo "   Bei absichtlichem Override: git push --no-verify" >&2
    exit 1
  fi
  echo "✅ Plan-Build-Verifikation OK (dist-plan/ aktuell)."
fi
