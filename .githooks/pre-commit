#!/bin/bash
cd "$(git rev-parse --show-toplevel)"

# --- View-Docs-Reminder (branch-unabhängig, non-blocking) ---------------
# Siehe src/views/AGENTS.md. War früher ein loser, nicht-versionierter Hook
# in .git/hooks/ — seit 2026-07-12 hier mitversioniert, damit core.hooksPath
# ihn nicht mehr stillschweigend abschaltet.
staged_all="$(git diff --cached --name-only)"
if [ -n "$staged_all" ]; then
  views="$(echo "$staged_all" | grep -oE '^src/views/[A-Za-z]+/' | sort -u)"
  flagged=""
  while IFS= read -r view; do
    [ -z "$view" ] && continue
    code_changed=$(echo "$staged_all" | grep -E "^${view}[A-Za-z0-9_.-]*\.(jsx|js)$")
    docs_changed=$(echo "$staged_all" | grep -E "^${view}(ARCHITECTURE|AUDIT)\.md$")
    if [ -n "$code_changed" ] && [ -z "$docs_changed" ]; then
      flagged="${flagged}${view}\n"
    fi
  done <<< "$views"

  if [ -n "$flagged" ]; then
    msg="View-Code geändert, aber ARCHITECTURE.md/AUDIT.md nicht mit im Commit:\n$(echo -e "$flagged")\nPrüfen ob Doku-Update nötig war (siehe src/views/AGENTS.md). Nur Reminder, kein Block."
    if command -v gum >/dev/null 2>&1; then
      gum log --level warn "$msg"
    else
      echo -e "\n⚠️  $msg\n" >&2
    fi
  fi
fi

# Plan's service worker and manifest are stamped into dist-plan by the
# mini-app-shell build step; source placeholders are not edited by this hook.

# --- Build-Verifikation (blocking, nur bei build-relevanten Dateien) ----
# Analog zum TRIGGER-Pattern im pre-push-Hook. Verhindert kaputte Commits
# frueh, statt erst beim dev-Push zu bemerken, dass pnpm run build fehlschlaegt.
BUILD_TRIGGER='^(src/|plan\.html$|public/|6pack/|Skills/|fitness/catalog/kb/|scripts/|vite\.config\.(js|ts|mjs)$|tailwind\.config\.cjs$|postcss\.config\.cjs$|package\.json$|pnpm-lock\.yaml$|firebase\.json$|firebase\.config\.js$)'
staged_files="$(git diff --cached --name-only)"
if echo "$staged_files" | grep -Eq "$BUILD_TRIGGER"; then
  if command -v gum >/dev/null 2>&1; then
    gum log --level info "plan-dev: build-relevante Dateien gestaged — pnpm run build zur Verifikation…"
  else
    echo "🔍 plan-dev: build-relevante Dateien gestaged — pnpm run build zur Verifikation…"
  fi
  if ! pnpm run build; then
    echo "❌ pnpm run build fehlgeschlagen — Commit wird abgebrochen." >&2
    echo "   Mit 'git commit --no-verify' kannst du den Hook überspringen, falls das Absicht ist." >&2
    exit 1
  fi
  echo "✅ Build-Verifikation OK."
fi
