rules_version = '2';

// Plan-App Rules (plan-dev / vos-plan).
// This file is the app-owned rule contract, for documentation only — it is
// never deployed from here (firebase.json has no firestore block on purpose).
// The deployable ruleset is registered in ~/vitalos/firestore.rules and
// deployed only from ~/vitalos.
//
// Plan reuses the same fitness/{uid}/... paths as fitness-dev/coach-dev
// (routines, wf_workouts, macrocycles, workouts, sessions, journal,
// habitJournals, settings, plan) — no new collections, already fully
// covered by the consolidated SSOT ruleset.

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }
    function owner(uid) {
      return authed() && request.auth.uid == uid;
    }
    function isCoach() {
      return authed() && (
        request.auth.token.coach == true
        || request.auth.uid == '59ole36uNpNwml5H6VDYCXyCME92'
        || (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
            && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'coach')
      );
    }

    match /roles/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    // Coach needs full direct access to client fitness records to build and
    // assign routines/macrocycles/workouts.
    match /fitness/{uid}/{document=**} {
      allow read, write: if owner(uid) || isCoach();
    }

    // Curated KB: clients can read, only Coach can edit.
    match /fitness/kb/{document=**} {
      allow read: if authed();
      allow write: if isCoach();
    }

    match /{path=**}/routines/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/workouts/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/wf_workouts/{doc} {
      allow read, write: if isCoach();
    }
    match /{path=**}/macrocycles/{doc} {
      allow read, write: if isCoach();
    }
  }
}
