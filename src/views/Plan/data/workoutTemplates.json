  "core": {
    "label": "6Pack Core-Intervalltraining",
    "notes": "Fester eigenständiger Trainingsbaustein an jedem Trainingstag, kein Restprogramm. Session in der 6Pack-App wählen; keine konkrete App-Session vorausgewählt. Nicht unmittelbar vor dem schweren Hauptlift ermüden."
  },
  "progression": "Arbeitsgewicht individuell wählen. Sind alle Sätze am oberen Wiederholungsziel mit stabiler Technik und der vorgesehenen Reserve geschafft, die kleinste sinnvolle Laststeigerung wählen. Andernfalls zunächst wiederholen; bei wiederholtem Leistungsabfall Last/Umfang und Erholung prüfen. Aufwärmsätze zusätzlich, keine erzwungenen Wiederholungen.",
  "levels": {
    "beginner": {
      "label": "Beginner",
      "main": {
        "sets": 2,
        "reps": "8-12",
        "restSeconds": 120,
        "rir": 3
      },
      "compound": {
        "sets": 2,
        "reps": "8-12",
        "restSeconds": 120,
        "rir": 3
      },
      "isolation": {
        "sets": 2,
        "reps": "10-15",
        "restSeconds": 90,
        "rir": 3
      },
      "notes": "Technik und gleichmäßige Wiederholungen aufbauen; keine erzwungenen Wiederholungen. Trainingslevel beschreibt hier die Dosierung, nicht eine automatisch geprüfte Eignung."
    },
    "intermediate": {
      "label": "Intermediate",
      "main": {
        "sets": 3,
        "reps": "8-12",
        "restSeconds": 150,
        "rir": 2
      },
      "compound": {
        "sets": 2,
        "reps": "8-12",
        "restSeconds": 120,
        "rir": 2
      },
      "isolation": {
        "sets": 3,
        "reps": "10-15",
        "restSeconds": 90,
        "rir": 2
      },
      "notes": "Doppelte Progression: erst Wiederholungen, dann Last erhöhen. Keine automatische Steigerung unabhängig von Technik und Reserve."
    },
    "advanced": {
      "label": "Advanced 5×5",
      "main": {
        "sets": 5,
        "reps": "5",
        "restSeconds": 180,
        "rir": 2
      },
      "compound": {
        "sets": 2,
        "reps": "8-12",
        "restSeconds": 120,
        "rir": 2
      },
      "isolation": {
        "sets": 3,
        "reps": "10-15",
        "restSeconds": 90,
        "rir": 2
      },
      "notes": "5×5 betrifft die Hauptübung. Last für fünf saubere Sätze mit Reserve wählen, nicht die persönliche 5-RM-Last. Weitere Compounds nur, wenn das Basic-Template sie enthält; five-two-legs hat strikt nur einen Compound pro Einheit."
    }
  },
